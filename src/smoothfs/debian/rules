#!/usr/bin/make -f
# Debian rules for smoothfs-dkms.
#
# The package ships the module source tree in /usr/src/smoothfs-<version>/
# with its dkms.conf; dh_dkms adds the DKMS add/build/install calls to the
# maintainer scripts, so DKMS builds smoothfs.ko for every installed kernel
# with headers and again on each kernel upgrade.
#
# <version> is the module's own (dkms.conf PACKAGE_VERSION, which
# release-please bumps); debian/changelog must carry the same upstream
# version (packaging/debian-changelog.sh writes it before a build).

VERSION := $(shell sed -n 's/^PACKAGE_VERSION="\([^"]*\)".*/\1/p' dkms.conf)
SRCDIR := debian/smoothfs-dkms/usr/src/smoothfs-$(VERSION)

%:
	dh $@ --with dkms

override_dh_auto_configure override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_auto_clean:
	# Nothing to build here: DKMS builds the module on the target, against
	# the target's kernel. (The Makefile's targets need kernel headers.)

override_dh_install:
	@[ -n "$(VERSION)" ] || { echo "no PACKAGE_VERSION in dkms.conf" >&2; exit 1; }
	@case "$$(dpkg-parsechangelog -S Version)" in "$(VERSION)"-*) ;; \
	    *) echo "debian/changelog is $$(dpkg-parsechangelog -S Version), dkms.conf is $(VERSION)" >&2; exit 1 ;; esac
	install -d $(SRCDIR)
	install -m 644 Kbuild Makefile dkms.conf *.c *.h $(SRCDIR)/
	# Operator tooling: documented and invokable, kept off $PATH.
	install -D -m 755 scripts/enroll-signing-cert.sh debian/smoothfs-dkms/usr/share/smoothfs-dkms/enroll-signing-cert.sh
	install -D -m 755 test/module_signing.sh debian/smoothfs-dkms/usr/share/smoothfs-dkms/module_signing.sh
	install -D -m 755 test/kernel_upgrade.sh debian/smoothfs-dkms/usr/share/smoothfs-dkms/kernel_upgrade.sh

# dh_dkms acts only on debian/<package>.dkms: generated from the module's own
# dkms.conf, with the version left for dh_dkms to fill in, so it cannot drift.
override_dh_dkms:
	sed 's/^PACKAGE_VERSION=.*/PACKAGE_VERSION="#MODULE_VERSION#"/' dkms.conf > debian/smoothfs-dkms.dkms
	dh_dkms -V $(VERSION)
	rm -f debian/smoothfs-dkms.dkms
